# ============================================================================
#  Mary brain — config. Copy to .env and fill in.
# ============================================================================

# --- Evolution API (the WhatsApp gateway) ---
EVOLUTION_URL=http://api:8080
EVOLUTION_APIKEY=change-me            # = Evolution's AUTHENTICATION_API_KEY
EVOLUTION_INSTANCE=secretaria

# --- Trigger + identity ---
MARY_TRIGGER_TAG=@mary                 # SECRETARY_TAG_NEW also accepted
OWNER_NAME=Marcelo

# --- Listening loop + Redis (window marker; in-memory fallback if unset) ---
REDIS_URL=
LOOP_TTL_SECONDS=60

# --- Memory ---
CONTEXT_WINDOW_MESSAGES=30
# LangGraph checkpointer (Postgres). In-memory fallback for dev/tests if unset.
DATABASE_URL=

# --- Reasoning (provider-neutral; Anthropic today) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=8192
WEB_SEARCH_MAX_USES=5
PROMPT_VERSION=2026-08-02.4
