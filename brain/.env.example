# ============================================================================
#  Mary brain — Step 1 config. Copy to .env and fill in.
#  Evolution values mirror the evolution/ stack (same instance & API key).
# ============================================================================

# --- Evolution API (the WhatsApp gateway we call directly) ---
EVOLUTION_URL=http://api:8080
EVOLUTION_APIKEY=change-me            # = Evolution's AUTHENTICATION_API_KEY
EVOLUTION_INSTANCE=secretaria

# --- Trigger ---
# Comma-separated, lowercase. @mary wakes the brain. SECRETARY_TAG_NEW is also
# accepted as an alias, so the old compose var keeps working.
MARY_TRIGGER_TAG=@mary

# --- Identity ---
OWNER_NAME=User
ACK_TEXT=🌿 Mary here — listening.

# --- Session / dedup (optional; in-memory fallback if REDIS_URL is unset) ---
REDIS_URL=
SESSION_TTL=1800

# --- Observability (optional) ---
# Set these to mirror the code-level trace to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mary-brain
