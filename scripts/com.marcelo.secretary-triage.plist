<?xml version="1.0" encoding="UTF-8"?>
<!--
  The self-learning TRIAGE loop: filter noisy machine error logs into real bugfix plans.
  Runs every 30 minutes (was once daily at 09:00). The FAST lane (com.marcelo.board-fetch)
  handles the pull + carding within ~1 min; this loop is the ~30-min filter that turns raw
  error reports into bugfix plans, which the fast lane then cards on its next tick. When the
  inbox is empty this run is a cheap no-op — no model call.

  Install with:
      cp scripts/com.marcelo.secretary-triage.plist ~/Library/LaunchAgents/
      launchctl unload ~/Library/LaunchAgents/com.marcelo.secretary-triage.plist 2>/dev/null
      launchctl load  ~/Library/LaunchAgents/com.marcelo.secretary-triage.plist
  Run it once, right now:
      launchctl start com.marcelo.secretary-triage
  Stop it for good:
      launchctl unload ~/Library/LaunchAgents/com.marcelo.secretary-triage.plist
  Watch it:
      tail -f ~/Library/Logs/secretary-triage.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marcelo.secretary-triage</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/marceloabritta/Desktop/Coding/Personal Whatsapp AI/scripts/self-learning-daily.sh</string>
    </array>

    <!-- Every 30 minutes. Cheap when the inbox is empty (no model call); when it has error
         reports, triage filters the noise and writes bugfix plans for the real ones. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Do NOT run on load/login: installing the job should not fire a triage run. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/marceloabritta/Library/Logs/secretary-triage.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marceloabritta/Library/Logs/secretary-triage.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/marceloabritta/Desktop/Coding/Personal Whatsapp AI</string>
</dict>
</plist>
