<?xml version="1.0" encoding="UTF-8"?>
<!--
  The FAST lane: pull + enqueue + drain every 60s, so feature requests and triaged bugfix
  plans become backlog cards within ~1 minute instead of at the next daily/30-min run.

  Every step is idempotent and a down board / unreachable droplet is a clean no-op, so a
  frequent tick is cheap and safe to leave running. Tune the cadence with StartInterval
  below (e.g. 120 to halve the SSH load to the droplet).

  Install with:
      cp scripts/com.marcelo.board-fetch.plist ~/Library/LaunchAgents/
      launchctl unload ~/Library/LaunchAgents/com.marcelo.board-fetch.plist 2>/dev/null
      launchctl load  ~/Library/LaunchAgents/com.marcelo.board-fetch.plist
  Run it once, right now:
      launchctl start com.marcelo.board-fetch
  Stop it for good:
      launchctl unload ~/Library/LaunchAgents/com.marcelo.board-fetch.plist
  Watch it:
      tail -f ~/Library/Logs/board-fetch.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marcelo.board-fetch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/marceloabritta/Desktop/Coding/Personal Whatsapp AI/scripts/board-fetch.sh</string>
    </array>

    <!-- Every 60 seconds. The whole run is idempotent and single-flight, so overlap is safe. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Fetch once as soon as the job is loaded (e.g. at login), then every 60s after. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/marceloabritta/Library/Logs/board-fetch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marceloabritta/Library/Logs/board-fetch.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/marceloabritta/Desktop/Coding/Personal Whatsapp AI</string>
</dict>
</plist>
