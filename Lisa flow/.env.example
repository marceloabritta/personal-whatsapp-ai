# ============================================================================
#  Mary brain — config. Copy to .env and fill in.
# ============================================================================

# --- Evolution API (the WhatsApp gateway) ---
EVOLUTION_URL=http://api:8080
EVOLUTION_APIKEY=change-me            # = Evolution's AUTHENTICATION_API_KEY
EVOLUTION_INSTANCE=secretaria

# --- Trigger + identity ---
MARY_TRIGGER_TAG=@mary                 # SECRETARY_TAG_NEW also accepted
OWNER_NAME=Marcelo

# --- Listening loop + Redis (window marker; in-memory fallback if unset) ---
REDIS_URL=
LOOP_TTL_SECONDS=60

# --- Memory ---
CONTEXT_WINDOW_MESSAGES=30
# LangGraph checkpointer (Postgres). In-memory fallback for dev/tests if unset.
DATABASE_URL=

# --- Reasoning (provider-neutral; Anthropic today) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=8192
WEB_SEARCH_MAX_USES=5
PROMPT_VERSION=2026-08-02.4

# --- Transcription (voice notes → text; provider-neutral, AssemblyAI today) ---
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=                     # required for transcription; unset → graceful degrade
ASSEMBLYAI_LANGUAGE=auto               # auto = provider detects; or an ISO code (en, pt, …)
LONG_AUDIO_SECONDS=120                  # past this, deliver the transcript as a .txt
MAX_CONTEXT_TRANSCRIPTIONS=8           # per-turn cap when hearing window audio
TRANSCRIBE_ON_EMPTY_REPLY=true         # bare @mary on a voice note → transcribe

# --- Media context (images & PDFs → inline base64 blocks for the model) ---
MEDIA_ENABLED=false                     # master switch; flip on after verifying
MAX_CONTEXT_MEDIA=8                     # per-turn image/PDF cap in the context pass
MEDIA_MAX_ITEM_BYTES=15000000           # per-file ceiling before a marker fallback
